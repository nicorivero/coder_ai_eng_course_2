# Copiar este archivo a .env y completar las keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor ("openai" o "anthropic") y modelo usados por el pipeline
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5

# Tope de tokens de salida; bajarlo mucho sirve para probar la detección de respuestas truncadas
LLM_MAX_TOKENS=1024
